<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
  http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>rest</groupId>
  <artifactId>RestKlient</artifactId>
  <version>1</version>
  <packaging>jar</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-maven-plugin</artifactId>
        <version>2.0.9</version>
        <executions>
          <execution>
            <id>jaxb-generate-Sklep</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <schemaIncludes>
                <include>jaxb/Sklep/*.xsd</include>
              </schemaIncludes>
              <episodeFile>${project.build.directory}/generated-sources/xjc-Sklep/META-INF/jaxb-Sklep.episode</episodeFile>
              <generateDirectory>${project.build.directory}/generated-sources/xjc-Sklep</generateDirectory>
              <generatePackage>myclasses</generatePackage>
            </configuration>
          </execution>
          <execution>
            <id>jaxb-generate-SklepBind</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <schemaIncludes>
                <include>jaxb/SklepBind/*.xsd</include>
              </schemaIncludes>
              <episodeFile>${project.build.directory}/generated-sources/xjc-SklepBind/META-INF/jaxb-SklepBind.episode</episodeFile>
              <generateDirectory>${project.build.directory}/generated-sources/xjc-SklepBind</generateDirectory>
              <generatePackage>myclasses</generatePackage>
            </configuration>
          </execution>
            <execution>
                <goals>
                    <goal>generate</goal>
                </goals>
                <configuration>
                    <schemaIncludes>
                        <include>jaxb/Sklep/*.xsd</include>
                    </schemaIncludes>
                    <episodeFile>${project.build.directory}/generated-sources/xjc-Sklep/META-INF/jaxb-Sklep.episode</episodeFile>
                    <generateDirectory>${project.build.directory}/generated-sources/xjc-Sklep</generateDirectory>
                    <generatePackage>myclasses</generatePackage>
                </configuration>
                <id>jaxb-generate-Sklep_2</id>
            </execution>
            <execution>
                <goals>
                    <goal>generate</goal>
                </goals>
                <configuration>
                    <schemaIncludes>
                        <include>jaxb/Sklep/*.xsd</include>
                    </schemaIncludes>
                    <episodeFile>${project.build.directory}/generated-sources/xjc-Sklep/META-INF/jaxb-Sklep.episode</episodeFile>
                    <generateDirectory>${project.build.directory}/generated-sources/xjc-Sklep</generateDirectory>
                    <generatePackage>myclasses</generatePackage>
                </configuration>
                <id>jaxb-generate-Sklep_3</id>
            </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/xjc-Sklep</source>
                <source>${project.build.directory}/generated-sources/xjc-SklepBind</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>javax.xml.bind</groupId>
      <artifactId>jaxb-api</artifactId>
      <version>2.3.1</version>
    </dependency>
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
      <version>2.3.1</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>2.3.1</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jersey.core</groupId>
      <artifactId>jersey-client</artifactId>
      <version>3.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jersey.media</groupId>
      <artifactId>jersey-media-json-binding</artifactId>
      <version>3.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jersey.inject</groupId>
      <artifactId>jersey-hk2</artifactId>
      <version>3.0.2</version>
    </dependency>
    <dependency>
    <groupId>jakarta.activation</groupId>
    <artifactId>jakarta.activation-api</artifactId>
    <version>2.1.1</version> <!-- lub nowsza -->
    </dependency>

  </dependencies>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>24</maven.compiler.release>
    <exec.mainClass>rest.restklient.RestKlient</exec.mainClass>
  </properties>

</project>
